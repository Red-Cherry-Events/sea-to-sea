---
import Icon from './Icon.astro';
import Cta from './Cta.astro';
import { packages, rand, deposit, swapFee, next, type Edition } from '../data/site';
interface Props { edition?: Edition }
const { edition = next } = Astro.props;
---
<div class="s2s-packages">
  {packages.filter((p) => p.id !== 'no-hassle' || edition.id === 'south').map((p, i) => (
    <article class={`s2s-package${i === 0 ? ' s2s-package--lead' : ''}`}>
      <h3 class="s2s-package__name">{p.name}</h3>
      <p class={`s2s-package__price${p.price == null ? ' is-tbc' : ''}`}>{rand(p.price)}{p.price != null && <span> {p.unit}</span>}</p>
      <p class="s2s-package__note small">{p.note}</p>
      <ul class="s2s-package__list">
        {p.items.map((it) => <li><Icon name="check" /><span>{it}</span></li>)}
      </ul>
      {i === 0 && <div><Cta edition={edition} /></div>}
    </article>
  ))}
</div>
<p class="small muted" style="margin-top: var(--space-4); max-width: 60em">
  {deposit != null && `A ${rand(deposit)} per person non-refundable deposit secures your entry, with the balance due 2 months before the event. `}
  Swap a rider at any time for R{swapFee}. <a href="/ride-info/#cancellation">Cancellation policy</a>
</p>
