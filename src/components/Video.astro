---
import Icon from './Icon.astro';
import FilmScript from './FilmScript.astro';
interface Props { id: string; poster: string; title: string; label?: string }
const { id, poster, title, label = 'Watch the film' } = Astro.props;
---
<div class="video" data-video={id} style={`background-image:url(https://i.ytimg.com/vi/${id}/hqdefault.jpg)`}>
  <img src={`/img/${poster}-1600.webp`} alt="" loading="lazy" decoding="async" fetchpriority="low" width="1600" height="900" />
  <button type="button" aria-label={`Play video: ${title}`}><span><Icon name="play" /><b>{label}</b></span></button>
</div>
<FilmScript />
