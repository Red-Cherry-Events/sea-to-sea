---
// A set of YouTube films. Each loads only when played. With more than 4, the first plays big and the rest sit in a grid.
import Icon from './Icon.astro';
import FilmScript from './FilmScript.astro';
import type { Film } from '../data/site';
interface Props { films: Film[] }
const { films } = Astro.props;
const cls = films.length > 4 ? 'films films--lib' : `films films--${films.length}`;
const poster = (f: Film) => (f.poster ? `/img/${f.poster}-800.webp` : `https://i.ytimg.com/vi/${f.id}/hqdefault.jpg`);
---
<div class={cls}>
  {films.map((f) => (
    <figure class="film">
      <div class="video" data-video={f.id} style={`background-image:url(https://i.ytimg.com/vi/${f.id}/hqdefault.jpg)`}>
        <img src={poster(f)} alt="" loading="lazy" decoding="async" fetchpriority="low" width="800" height="450" />
        <button type="button" aria-label={`Play video: ${f.title}`}><span><Icon name="play" /><b>Play</b></span></button>
      </div>
      <figcaption>{f.title}</figcaption>
    </figure>
  ))}
</div>
<FilmScript />
