---
// ItineraryDay rows for an edition with confirmed dates.
import type { Edition } from '../data/site';
interface Props { edition: Edition }
const { edition: e } = Astro.props;
const split = (d: string | null) => (d ?? '').split(' ');
const rows = [
  { d: e.dayDates[0], ride: false, label: 'Arrive', title: `Registration at ${e.startHotel.split(' (')[0]}`, meta: `Goodie bags, helmet check, dinner and the first riders’ briefing. Sleep: ${e.startHotel}.` },
  ...e.days.map((d, i) => ({ d: e.dayDates[i + 1], ride: true, label: `Day ${d.n}`, title: d.from === d.to ? `${d.from} loop` : `${d.from} to ${d.to}`, meta: `${d.body[0]} Sleep: ${i === 2 ? e.startHotel : e.midHotel}.` })),
  { d: e.dayDates[4], ride: false, label: 'Depart', title: 'Breakfast, then home', meta: 'Riders leave after breakfast, from 08:30.' },
];
---
<div class="s2s-days">
  {rows.map((r) => {
    const [dow, num, mon] = split(r.d);
    return (
      <div class={`s2s-day${r.ride ? ' s2s-day--ride' : ''}`}>
        <div class="s2s-day__date" aria-label={r.d ?? r.label}>
          <span class="s2s-day__dow" aria-hidden="true">{dow}</span>
          <span class="s2s-day__num" aria-hidden="true">{num}</span>
          <span class="s2s-day__mon" aria-hidden="true">{mon}</span>
        </div>
        <div>
          <span class="s2s-day__label">{r.label}</span>
          <h3 class="s2s-day__title">{r.title}</h3>
          <p class="s2s-day__meta">{r.meta}</p>
        </div>
      </div>
    );
  })}
</div>
