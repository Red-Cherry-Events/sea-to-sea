---
import Base from '../layouts/Base.astro';
import Pic from './Pic.astro';
import Cta from './Cta.astro';
import Days from './Days.astro';
import DayChapter from './DayChapter.astro';
import Schedule from './Schedule.astro';
import Hotels from './Hotels.astro';
import Grades from './Grades.astro';
import Included from './Included.astro';
import Packages from './Packages.astro';
import Films from './Films.astro';
import RouteExplorer from './RouteExplorer.astro';
import PhotoBand from './PhotoBand.astro';
import CoastGallery from './CoastGallery.astro';
import { site, when, editions, coastGallery, type Edition } from '../data/site';
interface Props { edition: Edition }
const { edition: e } = Astro.props;
const other = e.id === 'south' ? editions.north : editions.south;
const full = e.days.every((d) => d.km);
const band = e.id === 'south'
  ? { img: 'estuary-sun', alt: 'Morning light over a river mouth on the southern Wild Coast', h: 'Wild Coast mornings', p: 'Mist on the river mouths, cliffs above the sea, and nobody on the beach but your team.' }
  : { img: 'coast-aerial', alt: 'The Wild Coast from the air, with a track running along the cliffs', h: 'Dirt bike heaven', p: 'Mdumbi, Mpuzi, Mpami, Lapanzi and Hole in the Wall, all in three days of riding.' };
const schema = e.start ? [{
  '@context': 'https://schema.org', '@type': 'SportsEvent', name: `${e.name} ${e.year}`,
  startDate: e.start, endDate: e.end, eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: { '@type': 'Place', name: e.startHotel, address: { '@type': 'PostalAddress', addressRegion: 'Eastern Cape', addressCountry: 'ZA' } },
  organizer: { '@type': 'Organization', name: 'Red Cherry Events', url: 'https://www.redcherryevents.co.za/' },
  description: e.summary,
}] : [];
---
<Base title={e.short} description={`${e.name}: ${e.startHotel} to ${e.midHotel} and back. ${e.summary} ${when(e)}.`} schema={schema}>
  <section class="page-head">
    <div class="page-head__img"><Pic name={e.hero} alt={e.heroAlt} eager /></div>
    <div class="wrap">
      <h1 class="display-xl">Sea to Sea {e.short}</h1>
      <p class="page-facts"><span>{e.datesLong ?? 'Dates to be confirmed'}</span><span>{e.startHotel} · {e.midHotel}</span></p>
      <p class="lead">{e.intro[0]}</p>
      <div class="btn-row"><Cta edition={e} /><a class="s2s-btn s2s-btn--ghost" href="#routes">Explore the routes</a></div>
    </div>
  </section>

  <section class="s2s-facts" aria-label={`${e.short} in numbers`}>
    <div class="wrap s2s-facts__grid">
      <div class="s2s-facts__item"><div class="s2s-facts__num">3</div><div class="s2s-facts__label">Days riding</div></div>
      <div class="s2s-facts__item"><div class="s2s-facts__num">4</div><div class="s2s-facts__label">Nights in hotels</div></div>
      {e.totalKm
        ? <div class="s2s-facts__item"><div class="s2s-facts__num">{e.totalKm}</div><div class="s2s-facts__label">km on Gold</div></div>
        : <div class="s2s-facts__item"><div class="s2s-facts__num">~{site.avgDayKm}</div><div class="s2s-facts__label">km a day</div></div>}
      <div class="s2s-facts__item"><div class="s2s-facts__num">{site.teamsMax}</div><div class="s2s-facts__label">Teams max</div></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="stack">
        <h2 class="display-lg">{e.id === 'north' ? 'We are heading north' : 'From the far south'}</h2>
        <div class="prose">{e.intro.slice(1).map((p) => <p>{p}</p>)}
          <p>It’s not a race. The challenge is to get through the 3 days together with your team. No support driver needed: we move your luggage and fuel between hotels.</p>
        </div>
        {!e.dates && <div class="notice"><strong>Dates to be confirmed</strong><span>The next {e.short} dates aren’t set yet. Get on the list and we’ll tell you first.</span></div>}
      </div>
      <div class="split__img"><Pic name={e.id === 'north' ? 'coast-riders' : 'lookout'} alt={e.id === 'north' ? 'Two riders stop on a grassy ridge above the Wild Coast' : 'Riders standing on a grassy headland above the sea'} sizes="(min-width: 900px) 50vw, 100vw" /></div>
    </div>
  </section>

  <PhotoBand img={band.img} alt={band.alt} tall>
    <h2 class="display-xl">{band.h}</h2>
    <p class="lead">{band.p}</p>
  </PhotoBand>

  <section class="section band" id="days">
    <div class="wrap">
      <div class="stack" style="max-width: 44em; margin-bottom: var(--space-6)">
        <h2 class="display-lg">Day by day</h2>
        {full
          ? <p class="lead">{e.totalKm} km over 3 days on the Gold route: {e.days.map((d) => `${d.km} km`).join(', ')}. Silver is a little shorter. Gold and Silver split and rejoin through each day.</p>
          : <p class="lead">{e.startHotel} to {e.midHotel}, a loop, and back. Day distances are confirmed once the {e.year} route is ridden in. The average day is about {site.avgDayKm} km.</p>}
      </div>
      {full
        ? <div class="chapters">{e.days.map((d, i) => <DayChapter day={d} flip={i % 2 === 1} />)}</div>
        : <div class="split" style="align-items: start"><Days edition={e} /><div class="split__img sticky-col"><Pic name="green-rider" alt="A rider in bright green kit on a grassy coastal track" sizes="(min-width: 900px) 50vw, 100vw" /></div></div>}
    </div>
  </section>

  <section class="section" id="routes">
    <div class="wrap">
      <div class="stack" style="max-width: 44em; margin-bottom: var(--space-6)">
        <h2 class="display-lg">Explore the routes</h2>
        <p class="lead">Pick a day and a grade. Drag along the profile to follow the track, or hit Ride it and watch the day unfold.</p>
      </div>
      <RouteExplorer edition={e} />
    </div>
  </section>

  <section class="section" id="films">
    <div class="wrap">
      <h2 class="display-lg" style="margin-bottom: var(--space-6)">Watch {e.short}</h2>
      <Films films={e.videos} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="display-lg">Where you sleep</h2>
      <p class="lead" style="margin-top: var(--space-4)">Hotels only. You get your room details for all four nights at registration, and your bags are in your room when you ride in.</p>
      <Hotels edition={e} />
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <h2 class="display-lg">Pick your poison</h2>
      <p class="lead" style="margin-top: var(--space-4)">Gold, Silver or Adventure, every day. <a href="/the-journey/">More on the routes</a></p>
      <Grades />
    </div>
  </section>

  {e.id === 'south' && (
    <section class="section" aria-label="Photos from Sea to Sea South">
      <div class="wrap" style="margin-bottom: var(--space-6)"><h2 class="display-lg">On the route</h2></div>
      <div class="coast-wrap"><CoastGallery items={coastGallery.slice(0, 8)} /></div>
    </section>
  )}

  <section class="section" id="schedule">
    <div class="wrap">
      <div class="stack" style="max-width: 44em; margin-bottom: var(--space-6)">
        <h2 class="display-lg">The schedule</h2>
        <p class="lead">Registration: {e.registration.when}, at {e.registration.where}. Riders within a team register together.</p>
      </div>
      <Schedule edition={e} />
      <div class="btn-row" style="margin-top: var(--space-6)"><a class="s2s-btn s2s-btn--secondary" href="/ride-info/">All the ride info</a></div>
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <h2 class="display-lg">What’s included</h2>
      <Included />
    </div>
  </section>

  <section class="section" id="enter">
    <div class="wrap">
      <div class="stack" style="max-width: 44em; margin-bottom: var(--space-6)">
        <h2 class="display-lg">Entries</h2>
        <p class="lead">{e.entriesOpen ? `Limited to ${site.teamsMax} teams. Book early to avoid disappointment.` : `Entries for the next ${e.short} aren’t open yet. Limited to ${site.teamsMax} teams, so get on the list and we’ll tell you first.`}</p>
      </div>
      <Packages edition={e} />
      <div class="btn-row" style="margin-top: var(--space-5)"><a class="s2s-btn s2s-btn--secondary" href={e.hubUrl} rel="noopener">{e.short} in the Rider Hub</a></div>
    </div>
  </section>

  <section class="section band">
    <div class="wrap split">
      <div class="stack">
        <h2 class="display-lg">Also on the calendar</h2>
        <p class="lead">{other.name}: {other.startHotel} and {other.midHotel}. {other.summary} {when(other)}.</p>
        <div><a class="s2s-btn s2s-btn--ghost" href={other.href}>See {other.short}</a></div>
      </div>
      <div class="split__img"><Pic name={other.hero} alt={other.heroAlt} sizes="(min-width: 900px) 50vw, 100vw" /></div>
    </div>
  </section>
</Base>
