---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Packages from '../components/Packages.astro';
import Cta from '../components/Cta.astro';
import { site, next as e, editions, deposit, rand, entryFields, when } from '../data/site';
const n = editions.north;
---
<Base title="Enter here" description={`Enter your team for JBFE Sea to Sea. Rider entry ${rand(12650)}, supporter entry ${rand(11450)}. Limited to ${site.teamsMax} teams.`}>
  <PageHead title="Enter here" img="bush-climb" lead="Spots are limited by hotel space. Get your entries in early to avoid disappointment.">
    <p class="page-facts"><span>{e.short}: {when(e)}</span><span>{n.short}: {when(n)}</span></p>
    <div class="btn-row"><Cta /><a class="s2s-btn s2s-btn--ghost" href={site.loginUrl} rel="noopener">Log in to my entry</a></div>
  </PageHead>

  {!e.entriesOpen && (
    <section class="section" style="padding: var(--space-6) 0 0">
      <div class="wrap"><div class="notice"><strong>Entries open soon</strong><span>Entries for {e.name} {e.year} aren’t open yet. Get on the list and we’ll email you the day they open.</span></div></div>
    </section>
  )}

  <section class="section">
    <div class="wrap">
      <h2 class="display-lg" style="margin-bottom: var(--space-6)">How it works</h2>
      <ol class="steps">
        <li>
          <h3>Add your entries to the basket</h3>
          <p>Use the ticket selector on the Red Cherry Events entries site and add the entries your team needs to your cart.</p>
        </li>
        <li>
          <h3>Fill in your details</h3>
          <p>Have your partners’ details with you before you start. These are the fields you’ll be asked to complete for each rider.</p>
        </li>
        <li>
          <h3>Pay your deposits</h3>
          <p>Secure your entry with a {rand(deposit)} per person non-refundable deposit. <a href="/ride-info/#cancellation">Cancellation policy</a></p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section band">
    <div class="wrap split" style="align-items: start">
      <div class="stack">
        <h2 class="headline">The details you’ll need for every rider</h2>
        <ul class="chips">{entryFields.map((f) => <li>{f}</li>)}</ul>
        <div><a class="s2s-btn s2s-btn--ghost" href={site.fieldsPdf}>Download the list (PDF)</a></div>
      </div>
      <div class="stack">
        <h2 class="headline">Secure your race pack</h2>
        <div class="prose">
          <p>Enter before the race-pack deadline to secure your branded event merchandise, including your riding jersey, jacket and more.</p>
          <p class="muted">{e.racePackCloses ? `${e.name} race pack entries close ${e.racePackCloses}.` : `The race-pack deadline for ${e.name} ${e.year} is confirmed when entries open.`}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="packages">
    <div class="wrap">
      <h2 class="display-lg" style="margin-bottom: var(--space-6)">The packages</h2>
      <Packages />
    </div>
  </section>

  <section class="section band">
    <div class="wrap facts-list">
      <div>
        <h3>How teams work</h3>
        <p class="body">Teams are {site.teamSize}. Riders within a team register together and must all be at the briefing each evening. Each team can add up to two supporters.</p>
      </div>
      <div>
        <h3>Sharing rooms</h3>
        <p class="body">Teams may share rooms, and a supporter shares a room with a rider in their group. Entering as a bigger group? Tell us so we can keep you together.</p>
      </div>
      <div>
        <h3>Already entered?</h3>
        <p class="body"><a href={site.loginUrl} rel="noopener">Log in to my entry</a> to pay your balance or change ownership. The <a href={site.riderHubUrl} rel="noopener">Rider Hub</a> has your routes and event updates.</p>
      </div>
    </div>
  </section>
</Base>
