---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Pic from '../components/Pic.astro';
import Cta from '../components/Cta.astro';
import Days from '../components/Days.astro';
import Grades from '../components/Grades.astro';
import Included from '../components/Included.astro';
import EditionCards from '../components/EditionCards.astro';
import Testimonials from '../components/Testimonials.astro';
import Packages from '../components/Packages.astro';
import Video from '../components/Video.astro';
import { site, next as e } from '../data/site';

const schema = [{
  '@context': 'https://schema.org', '@type': 'SportsEvent', name: `${e.name} ${e.year}`,
  startDate: e.start, endDate: e.end, eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: { '@type': 'Place', name: e.startHotel, address: { '@type': 'PostalAddress', addressRegion: 'Eastern Cape', addressCountry: 'ZA' } },
  organizer: { '@type': 'Organization', name: 'Red Cherry Events', url: 'https://www.redcherryevents.co.za/' },
  image: 'https://www.seatosea.co.za/og/home.jpg',
  description: 'A 3-day navigational team enduro through the tribal lands of the Transkei on the Wild Coast.',
}];
---
<Base schema={schema}>
  <section class="hero">
    <div class="hero__img"><Pic name="coast-riders" alt="Two riders stop on a grassy ridge above the Wild Coast" eager /></div>
    <div class="wrap hero__inner">
      <img class="hero__badge" src="/logos/badge-480.webp" alt="JBFE Sea to Sea, an epic adventure" width="168" height="231" />
      <p class="hero__when"><span>{e.datesLong}</span> · Sea to Sea {e.short}</p>
      <h1 class="display-xl">Dirt bike heaven on the Wild Coast</h1>
      <p class="lead">A 3-day navigational team enduro, taking riders on a round trip through the tribal lands of the Transkei of South Africa. Staying at {e.startHotel} and {e.midHotel}.</p>
      <div class="btn-row">
        <Cta />
        <a class="s2s-btn s2s-btn--ghost" href="/ride-info/">Ride info</a>
      </div>
    </div>
  </section>

  <section class="s2s-facts" aria-label="The event in numbers">
    <div class="wrap s2s-facts__grid">
      <div class="s2s-facts__item"><div class="s2s-facts__num">3</div><div class="s2s-facts__label">Days riding</div></div>
      <div class="s2s-facts__item"><div class="s2s-facts__num">4</div><div class="s2s-facts__label">Nights in hotels</div></div>
      <div class="s2s-facts__item"><div class="s2s-facts__num">{site.teamsMax}</div><div class="s2s-facts__label">Teams max</div></div>
      <div class="s2s-facts__item"><div class="s2s-facts__num">3</div><div class="s2s-facts__label">Route grades</div></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="stack">
        <h2 class="display-lg">Who takes part?</h2>
        <div class="prose">
          <p class="lead">JBFE Sea to Sea is designed for the social enduro rider who wants to experience the Wild Coast and be part of an Epic Adventure.</p>
          <p>You don’t need a backup driver. The team from Red Cherry Events handles all of it. We take teams of {site.teamSize}, and hotels are where you sleep every night.</p>
          <p><strong>It’s not a race.</strong> The challenge is to get through the 3 days together with your partner. For safety there are checkpoints on the route and time bars in place. Keep a steady pace, stop for a pic or two, and you’ll get in safely and in time.</p>
          <p>It’s only suitable for enduro bikes, preferably with an electric start. The Adventure route takes the big adventure bikes.</p>
        </div>
        <div class="btn-row"><a class="s2s-btn s2s-btn--secondary" href="#packages">View packages</a></div>
      </div>
      <div class="split__img"><Pic name="team-beach" alt="A team of riders with arms raised beside their bikes above the beach" sizes="(min-width: 900px) 50vw, 100vw" /></div>
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <div class="stack" style="max-width: 44em">
        <h2 class="display-lg">Two rides a year</h2>
        <p class="lead">Same recipe, two stretches of coast. Around 60 teams navigate by GPS from hotel to hotel, do an out-ride on Day 2 with options to go Mild or Wild, and ride a new route back on Day 3.</p>
      </div>
      <EditionCards />
    </div>
  </section>

  <section class="section" id="routes">
    <div class="wrap">
      <div class="stack" style="max-width: 44em">
        <h2 class="display-lg">Pick your poison</h2>
        <p class="lead">Three routes to choose from each day: Gold, Silver or Adventure. Go Wild or keep it Mild.</p>
      </div>
      <Grades />
      <div class="btn-row" style="margin-top: var(--space-6)"><a class="s2s-btn s2s-btn--ghost" href="/the-journey/">View the journey</a></div>
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <div class="stack" style="max-width: 44em">
        <h2 class="display-lg">What’s included</h2>
        <p class="lead">Truly a hassle-free experience. You ride. We do the rest.</p>
      </div>
      <Included />
    </div>
  </section>

  <section class="section">
    <div class="wrap split split--flip" style="align-items: start">
      <div class="stack sticky-col">
        <h2 class="display-lg">{e.short}: five days, four nights</h2>
        <p class="lead">{e.name} starts and finishes at {e.startHotel}, with two nights at {e.midHotel} in the middle.</p>
        <div class="split__img"><Pic name="river-mouth" alt="Riders gathered on a dirt road at a river mouth by the sea" sizes="(min-width: 900px) 50vw, 100vw" /></div>
        <div class="btn-row"><a class="s2s-btn s2s-btn--secondary" href={e.href}>See {e.short} <Icon name="arrow" /></a><a class="s2s-btn s2s-btn--ghost" href={`${e.href}#schedule`}>Full schedule</a></div>
      </div>
      <Days edition={e} />
    </div>
  </section>

  <section class="section band">
    <div class="wrap split">
      <div class="split__img"><Pic name="fuel" alt="Rows of riders’ fuel cans packed on the luggage truck" small sizes="(min-width: 900px) 50vw, 100vw" /></div>
      <div class="stack">
        <h2 class="display-lg">Luggage and fuel drops</h2>
        <p class="lead">You don’t need a backup driver of your own. The Red Cherry team handles it all. A typical day goes like this.</p>
        <dl class="timetable">
          <div><dt>07:30</dt><dd>Drop your kit and fuel at the luggage truck</dd></div>
          <div><dt>08:00</dt><dd>Riders depart</dd></div>
          <div><dt>Midday</dt><dd>Water point 2 usually keeps lunch and fuel for each rider</dd></div>
          <div><dt>Afternoon</dt><dd>Arrive at the hotel. Your bags are waiting in your room.</dd></div>
        </dl>
        <div><a class="s2s-btn s2s-btn--ghost" href={`${e.href}#schedule`}>View the full schedule</a></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="stack">
        <h2 class="display-lg">Dads and their lads</h2>
        <div class="prose">
          <p class="lead">Every year a big group of youngsters ride JBFE Sea to Sea with their dads.</p>
          <p>We now take riders on 65s with long-range fuel tanks on the Silver routes. That means dads and their lads, usually 10 years old and up, can take this on with ease.</p>
          <p>We make special arrangements to move fuel to points on the route, so every bike can make it through the roughly {site.avgDayKm} km each day.</p>
        </div>
      </div>
      <div class="split__img"><Pic name="shade" alt="Riders resting in the shade of a tree above the beach" sizes="(min-width: 900px) 50vw, 100vw" /></div>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="wrap">
      <Video id={site.videoId} poster="speed" title="JBFE Sea to Sea" />
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <h2 class="display-lg">What riders say</h2>
      <Testimonials />
    </div>
  </section>

  <section class="section" id="packages">
    <div class="wrap">
      <div class="stack" style="max-width: 44em; margin-bottom: var(--space-6)">
        <h2 class="display-lg">The packages</h2>
        <p class="lead">Limited to {site.teamsMax} teams because of hotel space. Book early to avoid disappointment.</p>
      </div>
      <Packages />
      <div class="btn-row" style="margin-top: var(--space-5)"><a class="s2s-btn s2s-btn--ghost" href="/enter-here/">How entries work</a></div>
    </div>
  </section>

  <section class="section band">
    <div class="wrap hub">
      <div class="stack">
        <h2 class="display-lg">Check out our Rider Hub</h2>
        <div class="prose">
          <p class="lead">Everything you need for your ride, in one place.</p>
          <p>The Red Cherry Events Rider Hub is your go-to for everything about your event. Get important event information, rider details, updates, routes and more, on your phone or desktop.</p>
        </div>
        <div class="btn-row"><a class="s2s-btn s2s-btn--secondary" href={site.riderHubUrl} rel="noopener">Visit the Rider Hub</a><a class="s2s-btn s2s-btn--ghost" href={site.loginUrl} rel="noopener">Log in to my entry</a></div>
      </div>
      <img src="/img/rider-hub.webp" alt="The Rider Hub shown on a laptop and a phone" width="919" height="624" loading="lazy" />
    </div>
  </section>

  <section class="section" aria-label="Photos from past events">
    <div class="wrap mosaic">
      <figure class="w2 h2"><Pic name="coast-aerial" alt="The Wild Coast from the air, with a track along the cliffs" sizes="(min-width: 900px) 50vw, 100vw" /></figure>
      <figure><Pic name="chopper" alt="The medical helicopter on standby on a grassy headland" sizes="25vw" /></figure>
      <figure><Pic name="climb" alt="A rider on a steep rocky climb" sizes="25vw" /></figure>
      <figure class="w2"><Pic name="finish-arch" alt="The JBFE Sea to Sea finish arch" sizes="(min-width: 900px) 50vw, 100vw" /></figure>
      <figure class="w2"><Pic name="villages" alt="Rondavels on the hills above the sea" sizes="(min-width: 900px) 50vw, 100vw" /></figure>
      <figure><Pic name="goodie-tent" alt="Goodie bags laid out under the JBFE gazebos at registration" sizes="25vw" /></figure>
      <figure><Pic name="dunes" alt="Coastal dunes and bush from the air" sizes="25vw" /></figure>
    </div>
  </section>

  <section class="cta-band">
    <div class="cta-band__img"><Pic name="hole-in-wall" alt="" /></div>
    <div class="wrap">
      <span class="s2s-strap">An Epic Adventure</span>
      <h2 class="display-lg" style="max-width: 10ch">Get your team in</h2>
      <p class="lead" style="max-width: 26em">{e.name}, {e.dates} {e.year}. Limited to {site.teamsMax} teams.</p>
      <Cta />
    </div>
  </section>
</Base>
