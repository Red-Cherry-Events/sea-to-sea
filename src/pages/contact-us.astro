---
import Base from '../layouts/Base.astro';
import { contact } from '../data/site';
// Enquiries go to the Cherry Rider Hub: saved, emailed to the team, auto-reply sent,
// North interest logged, and (with consent) added to the Everlytic lists.
const action = 'https://riderhub.redcherryevents.co.za/api/public/s2s-enquiry';
---
<Base title="Contact" description="Get in touch with the Red Cherry Events team about JBFE Sea to Sea: phone, email, office hours and a message form.">
  <section class="section" style="padding-top: 120px">
    <div class="wrap contact-grid">
      <div class="stack">
        <h1 class="display-xl">Get in touch</h1>
        <p class="lead">Have a question for us? Ask away. Routes, bikes, rooms, bringing the kids: we’ve ridden every metre.</p>
        <div>
          <div class="contact-line"><span>Call</span><a href={contact.phoneHref}>{contact.phone}</a></div>
          <div class="contact-line"><span>Email</span><a href={`mailto:${contact.email}`}>{contact.email}</a></div>
          <div class="contact-line"><span>Location</span><strong>{contact.address.map((l) => <>{l}<br /></>)}</strong></div>
          <div class="contact-line"><span>Hours</span><div class="hours">{contact.hours.map(([d, h]) => <div><span>{d}</span><span>{h}</span></div>)}</div></div>
        </div>
      </div>
      <form id="message" class="form" method="POST" action={action} data-email={contact.email} novalidate>
        <h2 class="headline">Send us a message</h2>
        <label>Name <input name="name" autocomplete="name" required maxlength="120" /></label>
        <label>Email <input name="email" type="email" autocomplete="email" required /></label>
        <label>Phone number <span class="opt">(optional)</span><input name="phone" type="tel" autocomplete="tel" maxlength="40" /></label>
        <div class="form-two">
          <label>Which ride?
            <select name="ride" id="ride">
              <option value="south">Sea to Sea South</option>
              <option value="north">Sea to Sea North</option>
              <option value="both" selected>Both / not sure yet</option>
            </select>
          </label>
          <label>Team size <span class="opt">(optional)</span><input name="team_size" inputmode="numeric" maxlength="40" placeholder="e.g. 4 riders" /></label>
        </div>
        <label>Your message <textarea name="message" required maxlength="4000" placeholder="Let us know what’s on your mind. Want to hear when North entries open? Pick North above and we’ll tell you first."></textarea></label>
        <label class="consent"><input type="checkbox" name="consent" /><span>Send me Sea to Sea news and entry dates</span></label>
        <input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="form-foot">
          <button class="s2s-btn s2s-btn--primary" type="submit" data-send>Send message</button>
          <p class="form-note" role="status" aria-live="polite" data-note></p>
        </div>
      </form>
    </div>
  </section>
  <script>
    const form = document.getElementById('message') as HTMLFormElement | null;
    const about = new URLSearchParams(location.search).get('about');
    const sel = document.getElementById('ride') as HTMLSelectElement | null;
    if (about && sel && [...sel.options].some((o) => o.value === about)) sel.value = about;

    if (form) {
      const note = form.querySelector('[data-note]') as HTMLElement;
      const send = form.querySelector('[data-send]') as HTMLButtonElement;
      const say = (msg: string, ok: boolean) => { note.textContent = msg; note.dataset.state = ok ? 'ok' : 'bad'; };
      const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
      const mailto = (fd: FormData) => {
        const body = ['name', 'email', 'phone', 'ride', 'team_size', 'message'].map((k) => `${k}: ${fd.get(k) ?? ''}`).join('\n');
        location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent('Sea to Sea enquiry')}&body=${encodeURIComponent(body)}`;
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        if (!String(fd.get('name') || '').trim()) { say('Please add your name.', false); field('name').focus(); return; }
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(fd.get('email') || '').trim())) { say('Please add a valid email address so we can reply.', false); field('email').focus(); return; }
        if (String(fd.get('message') || '').trim().length < 2) { say('Please type your message.', false); field('message').focus(); return; }

        send.disabled = true; send.textContent = 'Sending…'; say('', true);
        try {
          const res = await fetch(form.action, { method: 'POST', body: fd, headers: { Accept: 'application/json' } });
          const j = await res.json().catch(() => null);
          if (res.ok && j && j.ok !== false) {
            form.reset();
            if (sel) sel.value = 'both';
            say('Thanks, your message is on its way. Check your inbox for our reply.', true);
            send.textContent = 'Sent';
            setTimeout(() => { send.disabled = false; send.textContent = 'Send message'; }, 4000);
            return;
          }
          if (j && j.error) { say(j.error, false); send.disabled = false; send.textContent = 'Send message'; return; }
          throw new Error('send failed');
        } catch {
          say(`That didn’t send from here. We’ve opened your email app instead, or write to ${form.dataset.email}.`, false);
          send.disabled = false; send.textContent = 'Send message';
          mailto(fd);
        }
      });
    }
  </script>
  <style is:global>
    .form .opt { font: 400 14px/20px var(--font-sans); text-transform: none; letter-spacing: 0; color: var(--ink-muted); }
    .form-two { display: grid; gap: var(--space-4); }
    @media (min-width: 560px) { .form-two { grid-template-columns: 1fr 1fr; } }
    .form label.consent { display: flex; align-items: flex-start; gap: var(--space-3); font: 400 16px/24px var(--font-sans); text-transform: none; letter-spacing: 0; cursor: pointer; }
    .form label.consent input { width: 22px; height: 22px; min-height: 0; margin: 1px 0 0; padding: 0; flex: none; accent-color: var(--sun); }
    .form .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
    .form-foot { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); }
    .form-note { margin: 0; font: 400 16px/24px var(--font-sans); }
    .form-note[data-state="ok"] { color: var(--sun); }
    .form-note[data-state="bad"] { color: #ff9b8a; }
    .form button[disabled] { opacity: .7; cursor: progress; }
  </style>
</Base>
