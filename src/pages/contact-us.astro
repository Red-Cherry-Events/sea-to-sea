---
import Base from '../layouts/Base.astro';
import { contact } from '../data/site';
const formId = import.meta.env.PUBLIC_FORMSPREE_ID;
---
<Base title="Contact" description="Get in touch with the Red Cherry Events team about JBFE Sea to Sea: phone, email, office hours and a message form.">
  <section class="section" style="padding-top: 120px">
    <div class="wrap contact-grid">
      <div class="stack">
        <h1 class="display-xl">Get in touch</h1>
        <p class="lead">Have a question for us? Ask away. Routes, bikes, rooms, bringing the kids: we’ve ridden every metre.</p>
        <div>
          <div class="contact-line"><span>Call</span><a href={contact.phoneHref}>{contact.phone}</a></div>
          <div class="contact-line"><span>Email</span><a href={`mailto:${contact.email}`}>{contact.email}</a></div>
          <div class="contact-line"><span>Location</span><strong>{contact.address.map((l) => <>{l}<br /></>)}</strong></div>
          <div class="contact-line"><span>Hours</span><div class="hours">{contact.hours.map(([d, h]) => <div><span>{d}</span><span>{h}</span></div>)}</div></div>
        </div>
      </div>
      <form id="message" class="form" method="POST" action={formId ? `https://formspree.io/f/${formId}` : `mailto:${contact.email}`} enctype={formId ? undefined : 'text/plain'}>
        <h2 class="headline">Send us a message</h2>
        <label>First name <input name="first-name" autocomplete="given-name" required /></label>
        <label>Last name <input name="last-name" autocomplete="family-name" required /></label>
        <label>Email <input name="email" type="email" autocomplete="email" required /></label>
        <label>Phone number <input name="phone" type="tel" autocomplete="tel" /></label>
        <label>Which ride?
          <select name="ride" id="ride">
            <option value="south">Sea to Sea South</option>
            <option value="north">Sea to Sea North</option>
            <option value="both">Both / not sure yet</option>
          </select>
        </label>
        <label>Comments <textarea name="comments" required maxlength="600" placeholder="Let us know what’s on your mind. Want to hear when entries open? Tell us your team size."></textarea></label>
        <div><button class="s2s-btn s2s-btn--primary" type="submit">Send message</button></div>
      </form>
    </div>
  </section>
  <script>
    const about = new URLSearchParams(location.search).get('about');
    const sel = document.getElementById('ride') as HTMLSelectElement | null;
    if (about && sel && [...sel.options].some((o) => o.value === about)) sel.value = about;
  </script>
</Base>
