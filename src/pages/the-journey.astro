---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Grades from '../components/Grades.astro';
import EditionCards from '../components/EditionCards.astro';
import Cta from '../components/Cta.astro';
import Films from '../components/Films.astro';
import PhotoBand from '../components/PhotoBand.astro';
import CoastGallery from '../components/CoastGallery.astro';
import { site, films, coastGallery } from '../data/site';
---
<Base title="The journey" description="3 days of riding around the tribal lands of the Transkei on Gold, Silver or Adventure routes. See what's in store on JBFE Sea to Sea South and North.">
  <PageHead title="The journey" img="river-wide" lead="3 days of riding around the tribal lands of the Transkei. Here’s what is in store for you on this Epic Adventure." />

  <section class="section" style="padding-top: var(--space-6)">
    <div class="wrap">
      <div class="stack" style="max-width: 44em">
        <h2 class="display-lg">3 routes available</h2>
        <p class="lead">Every day you choose between Gold, Silver and Adventure. Gold and Silver split and rejoin through the day, so a team can mix and still meet up.</p>
      </div>
      <Grades />
    </div>
  </section>

  <PhotoBand img="gorge" alt="A river cutting through a deep forested gorge, from the air" tall>
    <h2 class="display-xl">Go Wild or keep it Mild</h2>
    <p class="lead">75% of Gold and Silver is shared, so your team is never far apart, and never far from an escape.</p>
  </PhotoBand>

  <section class="section band">
    <div class="wrap">
      <div class="stack" style="max-width: 44em">
        <h2 class="display-lg">Day by day</h2>
        <p class="lead">Each edition has its own route, hotels and day-by-day write-up.</p>
      </div>
      <EditionCards />
    </div>
  </section>

  <section class="section">
    <div class="wrap"><Films films={films.journey} /></div>
  </section>

  <section class="section" style="padding-top: 0" aria-label="Photos of the route">
    <div class="coast-wrap"><CoastGallery items={coastGallery.slice(3)} /></div>
  </section>

  <section class="section">
    <div class="wrap facts-list">
      <div>
        <h3>How a riding day is built</h3>
        <p class="body">About {site.avgDayKm} km a day on Gold and Silver, and about 120 km on Adventure. Each day has 1 or 2 water points, a refuel point where the distance needs it, and a lunch stop. Checkpoints and time bars are there for safety.</p>
      </div>
      <div>
        <h3>Which bike?</h3>
        <p class="body">Gold and Silver are only suitable for enduro bikes, preferably with an electric start. Adventure is for the T7, 790, Africa Twin and the like. Skilled riders could tackle it on a 1290 or 1250.</p>
      </div>
      <div>
        <h3>Bringing the kids</h3>
        <p class="body">Riders on 65s with long-range fuel tanks take on the Silver routes, usually from 10 years old. We move fuel to extra points on the route so every bike makes the distance.</p>
      </div>
      <div>
        <h3>Navigation</h3>
        <p class="body">You navigate by GPS. Routes are emailed to every rider before the event, and we can load them for you at registration on Garmin eTrex devices. <a href="/ride-info/#gps">More on GPS</a></p>
      </div>
      <div>
        <h3>Riding through communities</h3>
        <p class="body">The routes cross the tribal lands of the Transkei and run through villages. Ride slowly past homes, livestock and kids, and greet people. We’re guests here.</p>
      </div>
      <div>
        <h3>The finish</h3>
        <p class="body">A free cold beer waits on the finish line every day. Day 3 ends under the JBFE Sea to Sea arch, and the last night is medals, prize-giving and a few fines.</p>
      </div>
    </div>
    <div class="wrap btn-row" style="margin-top: var(--space-7)"><Cta /><a class="s2s-btn s2s-btn--ghost" href="/ride-info/">Ride info</a></div>
  </section>
</Base>
